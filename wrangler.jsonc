{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slav-ai-api",
  "main": "worker.js",
  "compatibility_date": "2026-11-06",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/health"
    ]
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "slav-ai-db",
      "database_id": "24528809-058d-437d-a16c-f46d10011a20"
    }
  ]
}